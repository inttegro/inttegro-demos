{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inttegro-fastapi-demo",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"],
  "limits": {
    "cpu_ms": 10000
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/", "/checkout", "/complete", "/cancel", "/health", "/api/*"]
  },
  "python_modules": {
    "exclude": ["**/*.pyc", "**/__pycache__"]
  }
}
