{
  "name": "inttegro-demo-nestjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && concurrently -k -n server,client \"tsx watch src/main.ts\" \"vite build --watch\"",
    "build": "npm run build:server && npm run build:client",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm run typecheck:client && npm test",
    "typecheck:client": "svelte-check --tsconfig ./tsconfig.client.json"
  },
  "dependencies": {
    "@inttegro/inttegro-sdk": "14.1.1",
    "@inttegro/js": "0.7.2",
    "@inttegro/svelte": "0.7.2",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "concurrently": "10.0.7",
    "svelte-check": "4.7.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  },
  "overrides": {
    "devalue": "5.9.4",
    "multer": "2.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
